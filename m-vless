        if [ "$total_acc" -eq 0 ]; then echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy; return; fi

        echo -e "${G}Input type : deleteallusers\n             for Delete All Users RECOVERY${NC}\n"
        echo -e "${B}===============================================${NC}\n"
        echo -e "${G}Press CTRL+C for CANCEL${NC}\n"

        if [ "$total_acc" -eq 1 ]; then prompt_range="[1]"; else prompt_range="[1-$total_acc]"; fi
        echo -ne "${G}Select one client $prompt_range or [user] : ${NC}"; read client_opt

        if [[ "${client_opt,,}" == "deleteallusers" ]]; then
            echo -e "\n${G}Deleting all recovery users...${NC}\n"
            for u in "${orphan_users[@]}"; do
                sqlite3 "$DB_FILE" "DELETE FROM users WHERE username='$u' AND protocol='vless';"
                echo -e "${G}Deleted $u${NC}"
            done
            echo -e "\n${G}Successfully Deleted All Recovery Users${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy; continue 
        fi

        target_user=""
        valid_user=0
