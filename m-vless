        echo -e "${B}===============================================${NC}"
        printf "${O}  %-14s %-15s %s${NC}\n" "USERNAME" "EXP DATE" "STATUS"
        echo -e "${B}===============================================${NC}"

        today_sec=$(date +%s)
        mapfile -t vless_users < <(sqlite3 "$DB_FILE" "SELECT username, exp_date, password FROM users WHERE protocol='vless';")
        declare -a orphan_users; declare -A user_map; declare -A pass_map
        
        i=1
        for user_data in "${vless_users[@]}"; do
            username=$(echo "$user_data" | awk -F'|' '{print $1}')
            exp_date=$(echo "$user_data" | awk -F'|' '{print $2}')
            pass_db=$(echo "$user_data" | awk -F'|' '{print $3}')
            
            if [[ "$username" == trial-* ]]; then continue; fi
            
            exp_sec=$(date -d "$exp_date" +%s 2>/dev/null)
            if [[ -n "$exp_sec" && "$today_sec" -ge "$exp_sec" ]]; then
                formatted_date=$(date -d "$exp_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date")
                orphan_users+=("$username"); user_map[$i]="$username"; pass_map[$username]="$pass_db"
                printf "${G}%2d) %-14s %-15s %s${NC}\n" "$i" "${username:0:14}" "$formatted_date" "RECOVERY"
                ((i++))
            fi
        done

        total_acc=${#orphan_users[@]}
        if [ "$total_acc" -eq 0 ]; then echo -e "${G}             No User Found                   ${NC}"; fi
        echo -e "${B}===============================================${NC}"
        if [ "$total_acc" -le 1 ]; then echo -e "${O} Total Account: $total_acc user${NC}"; else echo -e "${O} Total Account: $total_acc users${NC}"; fi
