trial_vless() {
    trap 'echo -e "\n"; return' INT
    clear
    echo -e " ————————————————————————————————————————"
    echo -e "             ${G}LBJ Tunneling${NC}             "
    echo -e " ————————————————————————————————————————\n"
    echo -e "               ${PINK}XRAY VLESS${NC}                "
    echo -e " ————————————————————————————————————————\n"
    echo -e "${G}Time Format :\n\n  h - H (Hours)\n  m - M (Minutes)\n\nExample : ${O}1h${NC} ${G}for 1 hours${NC}\n\n${R}Press CTRL+C for CANCEL${NC}\n"
    echo -e " ————————————————————————————————————————\n"

    while true; do
        echo -ne "${G}Trial Time       : ${NC}"; read trial_time
        unit=$(echo $trial_time | grep -o -i '[a-z]')
        val=$(echo $trial_time | grep -o '[0-9]*')

        if [[ "${unit,,}" == "h" ]] && [ -n "$val" ]; then
            exp_display="$val Hour"; exp_db=$(date -d "+$val hour" +"%Y-%m-%d %H:%M:%S"); break
        elif [[ "${unit,,}" == "m" ]] && [ -n "$val" ]; then
            exp_display="$val Minute"; exp_db=$(date -d "+$val minute" +"%Y-%m-%d %H:%M:%S"); break
        else echo -en "\e[1A\e[K"; fi
    done

    while true; do echo -ne "${G}Quota Limit (GB) : ${NC}"; read quota; if [[ "$quota" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done

    user="trial-$(tr -dc 'a-z0-9' < /dev/urandom | head -c 5)"
    uuid=$(cat /proc/sys/kernel/random/uuid)
    iplimit=1

    sqlite3 "$DB_FILE" "INSERT INTO users (username, protocol, exp_date, ip_limit, password, quota) VALUES ('$user', 'vless', '$exp_db', '$iplimit', '$uuid', '$quota');"

