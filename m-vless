    echo -e "${G}You Choose ${O}☞${G} $target_user [RECOVERY]${NC}\n"
    echo -e "${G}Don't use special characters and uppercase!\n\nJust input a number for-\n Quota Limit\n Limit IP\nFormat GB\n\n${O}0${NC} ${G}for Unlimited\n${O}0${NC} ${G}for No Limit\n\n${R}Press CTRL+C for CANCEL${NC}"
