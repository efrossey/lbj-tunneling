#!/bin/bash

G="\e[92m"; O="\e[93m"; C="\e[36m"; B="\e[36m"; P="\e[35m"; PINK="\e[95m"; BG_RED="\e[41m"; BG_BLUE="\e[44m"; R="\e[91m"; NC="\e[0m"
DB_FILE="/etc/vpn/database.db"
DOMAIN=$(cat /etc/vpn/domain.txt 2>/dev/null)
CITY=$(curl -s4 http://ip-api.com/line?fields=city || curl -s4 https://ipinfo.io/city || echo "Unknown")
ISP=$(curl -s4 http://ip-api.com/line?fields=isp || curl -s4 https://ipinfo.io/org | cut -d " " -f 2- || echo "Unknown")

create_vless() {
    trap 'echo -e "\n"; return' INT
    while true; do
        clear
        echo -e " ————————————————————————————————————————"
        echo -e "             ${G}LBJ Tunneling${NC}             "
        echo -e " ————————————————————————————————————————\n"
        echo -e "               ${PINK}XRAY VLESS${NC}                "
        echo -e " ————————————————————————————————————————\n"
        echo -e "${G}Don't use special characters and uppercase!\n\nJust input a number for-\n Quota Limit\n Limit IP\nFormat GB\n\n${O}0${NC} ${G}for Unlimited\n${O}0${NC} ${G}for No Limit\n\n${G}Press CTRL+C for CANCEL${NC}\n"
        echo -e " ————————————————————————————————————————\n"
        
        echo -ne "${G}Username         : ${NC}"; read user
        if [[ -z "$user" ]]; then continue; fi
        
        if [[ ${#user} -lt 3 ]] || [[ ${#user} -gt 17 ]]; then
            echo -e "\n${R}Minimum 3 characters\nMaximum 17 characters\nTry again in 2 second${NC}\n"; sleep 2; continue
        elif [[ ! "$user" =~ ^[a-z0-9]+$ ]]; then
            echo -e "\n${R}Don't use special characters and uppercase!\nTry again in 2 seconds${NC}\n"; sleep 2; continue
        fi

        db_check=$(sqlite3 "$DB_FILE" "SELECT username FROM users WHERE username='$user' AND protocol='vless';")
        if [[ -n "$db_check" ]]; then
            exist_uuid=$(sqlite3 "$DB_FILE" "SELECT password FROM users WHERE username='$user' AND protocol='vless';")
            exist_exp=$(sqlite3 "$DB_FILE" "SELECT exp_date FROM users WHERE username='$user' AND protocol='vless';")
            echo -e "\n${G}Username         : ${O}${user}\n${G}Uuid             : ${O}${exist_uuid}\n${G}Exp              : ${O}${exist_exp}\n${G}Status           : ${G}Already Exists\n\nTry again in 2 seconds${NC}\n"; sleep 2; continue
        else break; fi
    done
    
    while true; do echo -ne "${G}Quota Limit (GB) : ${NC}"; read quota; if [[ "$quota" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Limit (IP)       : ${NC}"; read iplimit; if [[ "$iplimit" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Expired (days)   : ${NC}"; read days; if [[ "$days" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done

    uuid=$(cat /proc/sys/kernel/random/uuid)
    exp=$(date -d "+$days days" +"%Y-%m-%d")

    sqlite3 "$DB_FILE" "INSERT INTO users (username, protocol, exp_date, ip_limit, password, quota) VALUES ('$user', 'vless', '$exp', '$iplimit', '$uuid', '$quota');"

    vless_tls="vless://${uuid}@${DOMAIN}:443?path=/vless&security=tls&encryption=none&host=${DOMAIN}&type=ws&sni=${DOMAIN}#${user}"
    vless_ntls="vless://${uuid}@${DOMAIN}:80?path=/vless&security=none&encryption=none&host=${DOMAIN}&type=ws#${user}"
    vless_grpc="vless://${uuid}@${DOMAIN}:443?mode=gun&security=tls&encryption=none&type=grpc&serviceName=vless&sni=${DOMAIN}#${user}"
    vless_uptls="vless://${uuid}@${DOMAIN}:443?path=/upvless&security=tls&encryption=none&host=${DOMAIN}&type=httpupgrade&sni=${DOMAIN}#${user}"
    vless_upntls="vless://${uuid}@${DOMAIN}:80?path=/upvless&security=none&encryption=none&host=${DOMAIN}&type=httpupgrade#${user}"

    clear
    echo -e " ————————————————————————————————————————"
    echo -e "             ${G}LBJ Tunneling${NC}             "
    echo -e " ————————————————————————————————————————\n"
    echo -e "               ${PINK}XRAY VLESS${NC}                "
    echo -e " ————————————————————————————————————————\n"
    echo -e "${G} VLESS\n\n Remarks       : ${user}\n CITY          : ${CITY}\n ISP           : ${ISP}\n Domain        : ${DOMAIN}\n Port TLS      : 443,8443\n Port none TLS : 80,8080\n Port any      : 2052,2053,8880\n id            : ${uuid}\n Encryption    : none\n Network       : ws,grpc,upgrade\n Path ws       : /vless\n serviceName   : vless\n Path upgrade  : /upvless${NC}\n"
    echo -e " ————————————————————————————————————————"
    echo -e "${G} Link TLS         : ${vless_tls}${NC}"
    echo -e " ————————————————————————————————————————"
    echo -e "${G} Link none TLS    : ${vless_ntls}${NC}"
    echo -e " ————————————————————————————————————————"
    echo -e "${G} Link GRPC        : ${vless_grpc}${NC}"
    echo -e " ————————————————————————————————————————"
    echo -e "${G} Link Upgrade TLS : ${vless_uptls}${NC}"
    echo -e " ————————————————————————————————————————"
    echo -e "${G} Link Upgrade nTLS: ${vless_upntls}${NC}"
    echo -e " ————————————————————————————————————————"
    echo -e "         ${O}Expired  :  ${exp}${NC}"
    echo -e " ————————————————————————————————————————\n"
    echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

