renew_vmess() {
    trap 'echo -e "\n"; return' INT
    while true; do
        clear
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e ""
        echo -e "                    ${PINK}VMESS                    ${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e ""
        echo -e "${B}===============================================${NC}"
        printf "${O}  %-14s %-15s %s${NC}\n" "USERNAME" "EXP DATE" "STATUS"
        echo -e "${B}===============================================${NC}"

        mapfile -t vmess_users < <(sqlite3 "$DB_FILE" "SELECT username, exp_date, status, quota FROM users WHERE protocol='vmess';")
        total_acc=${#vmess_users[@]}

        declare -A user_map
        declare -A exp_map
        declare -A quota_map
        if [ "$total_acc" -eq 0 ]; then echo -e "${G}              No User Found                    ${NC}"
        else
            i=1
            for user_data in "${vmess_users[@]}"; do
                username=$(echo "$user_data" | awk -F'|' '{print $1}')
                exp_date=$(echo "$user_data" | awk -F'|' '{print $2}')
                status_db=$(echo "$user_data" | awk -F'|' '{print $3}')
                quota_db=$(echo "$user_data" | awk -F'|' '{print $4}')
                
                exp_sec=$(date -d "$exp_date" +%s 2>/dev/null)
                today_sec=$(date +%s)
                if [[ -n "$exp_sec" && "$today_sec" -ge "$exp_sec" ]]; then continue; fi

                if [[ "$exp_date" == *" "* ]]; then
                    clean_date=$(echo "$exp_date" | cut -d' ' -f1); formatted_date=$(date -d "$clean_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date")
                else formatted_date=$(date -d "$exp_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date"); fi
                
                status_show="UNLOCKED"
                if [ "$status_db" == "locked" ]; then status_show="LOCKED"; fi
                printf "${G}%2d) %-14s %-15s %s${NC}\n" "$i" "${username:0:14}" "$formatted_date" "$status_show"
                user_map[$i]="$username"
                exp_map[$username]="$exp_date"
                quota_map[$username]="$quota_db"
                ((i++))
            done
        fi

        echo -e "${B}===============================================${NC}"
        if [ "$total_acc" -le 1 ]; then echo -e "${O} Total Account: $total_acc user${NC}"; else echo -e "${O} Total Account: $total_acc users${NC}"; fi
        echo -e "${B}===============================================${NC}"
        echo -e "\n${G}Press CTRL+C for CANCEL${NC}\n"
        if [ "$total_acc" -eq 0 ]; then echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy; return; fi

        if [ "$total_acc" -eq 1 ]; then prompt_range="[1]"; else prompt_range="[1-$total_acc]"; fi
        echo -ne "${G}Select client $prompt_range or [user]: ${NC}"; read client_opt

        target_user=""
        valid_user=0
        if [[ "$client_opt" =~ ^[0-9]+$ ]] && [ "$client_opt" -le "$total_acc" ] && [ "$client_opt" -gt 0 ]; then
            target_user="${user_map[$client_opt]}"; valid_user=1
        else
            for i in "${!user_map[@]}"; do
                if [ "${user_map[$i]}" == "$client_opt" ]; then target_user="$client_opt"; valid_user=1; break; fi
            done
        fi
        if [ "$valid_user" -eq 0 ]; then echo -e "\n${R}User Not Found\nTry again in 2 second${NC}\n"; sleep 2; continue; else break; fi
    done

    echo -e "\n${G}You Choose ${C}☞${NC} ${G}$target_user [renew]${NC}\n"
    while true; do echo -ne "${G}Day   Extend     :  ${NC}"; read ext_days; if [[ "$ext_days" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Quota Extend     :  ${NC}"; read quota_ext; if [[ "$quota_ext" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Reset Quota (y/n):  ${NC}"; read rst_quota; if [[ "${rst_quota,,}" == "y" || "${rst_quota,,}" == "n" ]]; then break; else echo -en "\e[1A\e[K"; fi; done

    old_exp="${exp_map[$target_user]}" 
    if [[ "$old_exp" == *" "* ]]; then old_exp=$(echo "$old_exp" | cut -d' ' -f1); fi

    old_exp_sec=$(date -d "$old_exp" +%s 2>/dev/null)
    today_sec=$(date +%s)
    if [[ -n "$old_exp_sec" && "$old_exp_sec" -gt "$today_sec" ]]; then
        new_exp=$(date -d "$old_exp + $ext_days days" +"%Y-%m-%d")
    else new_exp=$(date -d "+$ext_days days" +"%Y-%m-%d"); fi
    display_exp=$(date -d "$new_exp" +"%d %b, %Y")

    old_quota="${quota_map[$target_user]}"
    if [ -z "$old_quota" ]; then old_quota=0; fi
    new_quota=$((old_quota + quota_ext))

    sqlite3 "$DB_FILE" "UPDATE users SET exp_date='$new_exp', quota='$new_quota' WHERE username='$target_user' AND protocol='vmess';"

    echo -e "\n${B}===============================================${NC}\n"
    echo -e "${G}Username         :  $target_user\nQuota            :  ${new_quota}.0GB\nDays Added until :  $ext_days Days\nExpires on       :  $display_exp${NC}"
    echo -e "\n${B}===============================================${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

