check_login_vmess() {
    trap 'echo -e "\n"; return' INT
    clear
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e ""
    echo -e "               ${C}VMESS USER LOGIN                ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    printf "${O}  %-14s %-7s %-7s %s${NC}\n" "USER" "USAGE" "TOTAL" "LOG"
    echo -e "${B}-----------------------------------------------${NC}"
    
    if [ -f /var/log/xray/access.log ]; then
        mapfile -t active_users < <(grep "accepted" /var/log/xray/access.log | awk '{print $4}' | cut -d':' -f1 | sort | uniq)
    else active_users=(); fi
    
    total_login=0
    if [ ${#active_users[@]} -gt 0 ]; then
        for u in "${active_users[@]}"; do
            if [[ "$u" == "email:"* ]]; then
                user="${u/email: /}"
                usage="0GB"
                ips=$(grep "accepted" /var/log/xray/access.log | grep -w "$u" | awk '{print $3}' | cut -d':' -f1 | sort -u | wc -l)
                log_id=$RANDOM
                printf "${G}  %-14s %-7s %-7s %s${NC}\n" "${user:0:14}" "${usage}" "${ips} IP" "${log_id}"
                ((total_login++))
            fi
        done
    fi

    if [ "$total_login" -eq 0 ]; then echo -e "${G}           No Active Login${NC}"; fi
    echo -e "${B}-----------------------------------------------${NC}"
    if [ "$total_login" -le 1 ]; then echo -e "${O} Total Account: $total_login users login${NC}"; else echo -e "${O} Total Account: $total_login users login${NC}"; fi
    echo -e "${B}-----------------------------------------------${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

