#!/bin/bash

# ==========================================
# VARIABEL WARNA & DATABASE
# ==========================================
G="\e[92m"       # Hijau Terang
O="\e[93m"       # Oranye/Kuning
C="\e[36m"       # Cyan Terang
B="\e[36m"       # Biru Terang / Cyan
P="\e[35m"       # Ungu (Purple/Magenta)
PINK="\e[95m"    # Pink Terang
BG_RED="\e[41m"  # Background Merah
BG_BLUE="\e[44m" # Background Biru
R="\e[91m"       # Merah Terang
NC="\e[0m"       # Reset Warna

DB_FILE="/etc/vpn/database.db"
DOMAIN=$(cat /etc/vpn/domain.txt 2>/dev/null)
CITY=$(curl -s4 http://ip-api.com/line?fields=city || curl -s4 https://ipinfo.io/city || echo "Unknown")
ISP=$(curl -s4 http://ip-api.com/line?fields=isp || curl -s4 https://ipinfo.io/org | cut -d " " -f 2- || echo "Unknown")

# ==========================================
# FUNGSI VMESS UTILITIES
# ==========================================

create_vmess() {
    trap 'echo -e "\n"; return' INT
    while true; do
        clear
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e ""
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "                     ${PINK}VMESS                     ${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e ""
        echo -e "${G}Don't use special characters and uppercase!${NC}"
        echo -e ""
        echo -e "${G}Just input a number for-${NC}"
        echo -e "${G} Quota Limit${NC}"
        echo -e "${G} Limit IP${NC}"
        echo -e "${G}Format GB${NC}"
        echo -e ""
        echo -e "${O}0${NC} ${G}for Unlimited${NC}"
        echo -e "${O}0${NC} ${G}for No Limit${NC}"
        echo -e ""
        echo -e "${G}Press CTRL+C for CANCEL${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e ""
        
        echo -ne "${G}Username         : ${NC}"; read user
        if [[ -z "$user" ]]; then continue; fi
        
        if [[ ${#user} -lt 3 ]] || [[ ${#user} -gt 17 ]]; then
            echo -e "\n${R}Minimum 3 characters${NC}"
            echo -e "${R}Maximum 17 characters${NC}"
            echo -e "${R}Try again in 2 second${NC}\n"
            sleep 2
            continue
        elif [[ ! "$user" =~ ^[a-z0-9]+$ ]]; then
            echo -e "\n${R}Don't use special characters and uppercase!${NC}"
            echo -e "\n${R}Try again in 2 seconds${NC}\n"
            sleep 2
            continue
        fi

        db_check=$(sqlite3 "$DB_FILE" "SELECT username, password, exp_date FROM users WHERE username='$user' AND protocol='vmess';")
        if [[ -n "$db_check" ]]; then
            exist_uuid=$(echo "$db_check" | awk -F'|' '{print $2}')
            exist_exp=$(echo "$db_check" | awk -F'|' '{print $3}')
            echo -e "\n${G}Username         : ${O}${user}${NC}"
            echo -e "${G}Uuid             : ${O}${exist_uuid}${NC}"
            echo -e "${G}Exp              : ${O}${exist_exp}${NC}"
            echo -e "${G}Status           : ${G}Already Exists${NC}"
            echo -e "\n${G}Try again in 2 seconds${NC}\n"
            sleep 2
            continue
        else
            break
        fi
    done
    
    while true; do echo -ne "${G}Quota Limit (GB) : ${NC}"; read quota; if [[ "$quota" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Limit (IP)       : ${NC}"; read iplimit; if [[ "$iplimit" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Expired (days)   : ${NC}"; read days; if [[ "$days" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done

    uuid=$(cat /proc/sys/kernel/random/uuid)
    exp=$(date -d "+$days days" +"%Y-%m-%d")

    sqlite3 "$DB_FILE" "INSERT INTO users (username, protocol, exp_date, ip_limit, password, quota) VALUES ('$user', 'vmess', '$exp', '$iplimit', '$uuid', '$quota');"

    json_tls='{"v":"2","ps":"'$user'","add":"'$DOMAIN'","port":"443","id":"'$uuid'","aid":"0","net":"ws","path":"/vmess","type":"none","host":"'$DOMAIN'","sni":"'$DOMAIN'","tls":"tls"}'
    vmess_tls="vmess://$(echo -n "$json_tls" | base64 -w 0)"
    json_ntls='{"v":"2","ps":"'$user'","add":"'$DOMAIN'","port":"80","id":"'$uuid'","aid":"0","net":"ws","path":"/vmess","type":"none","host":"'$DOMAIN'","sni":"'$DOMAIN'","tls":"none"}'
    vmess_ntls="vmess://$(echo -n "$json_ntls" | base64 -w 0)"
    json_grpc='{"v":"2","ps":"'$user'","add":"'$DOMAIN'","port":"443","id":"'$uuid'","aid":"0","net":"grpc","path":"vmess","type":"none","host":"'$DOMAIN'","sni":"'$DOMAIN'","tls":"tls"}'
    vmess_grpc="vmess://$(echo -n "$json_grpc" | base64 -w 0)"
    json_uptls='{"v":"2","ps":"'$user'","add":"'$DOMAIN'","port":"443","id":"'$uuid'","aid":"0","net":"httpupgrade","path":"/upvmess","type":"none","host":"'$DOMAIN'","sni":"'$DOMAIN'","tls":"tls"}'
    vmess_uptls="vmess://$(echo -n "$json_uptls" | base64 -w 0)"
    json_upntls='{"v":"2","ps":"'$user'","add":"'$DOMAIN'","port":"80","id":"'$uuid'","aid":"0","net":"httpupgrade","path":"/upvmess","type":"none","host":"'$DOMAIN'","sni":"'$DOMAIN'","tls":"none"}'
    vmess_upntls="vmess://$(echo -n "$json_upntls" | base64 -w 0)"

    clear
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e ""
    echo -e "                 ${PINK}XRAY VMESS                  ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e ""
    echo -e "${G}VMESS${NC}"
    echo -e ""
    echo -e "${G}Remarks      : ${user}${NC}"
    echo -e "${G}CITY         : ${CITY}${NC}"
    echo -e "${G}ISP          : ${ISP}${NC}"
    echo -e "${G}Domain       : ${DOMAIN}${NC}"
    echo -e "${G}Port TLS     : 443,8443${NC}"
    echo -e "${G}Port nTLS    : 80,8080${NC}"
    echo -e "${G}Port Any     : 2052,2053,8880${NC}"
    echo -e "${G}id           : ${uuid}${NC}"
    echo -e "${G}alterId      : 0${NC}"
    echo -e "${G}Security     : auto${NC}"
    echo -e "${G}network      : ws,grpc,upgrade${NC}"
    echo -e "${G}path ws      : /vmess - /whatever${NC}"
    echo -e "${G}serviceName  : vmess${NC}"
    echo -e "${G}path upgrade : /upvmess${NC}"
    echo -e ""
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}link TLS     : ${vmess_tls}${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}link none TLS: ${vmess_ntls}${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}link GRPC    : ${vmess_grpc}${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}link Upgrade TLS: ${vmess_uptls}${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}link Upgrade nTLS: ${vmess_upntls}${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${O}     Expired  :  ${exp}${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

