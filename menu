cat > /usr/bin/menu << 'EOF'
#!/bin/bash

# ==========================================
# VARIABEL WARNA (ANSI CODES)
# ==========================================
G="\e[92m"; O="\e[93m"; C="\e[36m"; B="\e[36m"; P="\e[35m"; PINK="\e[95m"; BG_RED="\e[41m"; R="\e[91m"; NC="\e[0m"

XRAY_CONF="/usr/local/etc/xray/config.json"
DB_FILE="/etc/vpn/database.db"

# Pastikan folder dan file dinamis tersedia
mkdir -p /etc/vpn
if [ ! -f /etc/vpn/client.txt ]; then echo "LBJ-Server" > /etc/vpn/client.txt; fi
if [ ! -f /etc/vpn/exp.txt ]; then date -d "+360 days" +"%Y-%m-%d" > /etc/vpn/exp.txt; fi

DOMAIN=$(cat /etc/vpn/domain.txt 2>/dev/null)
CLIENT_NAME=$(cat /etc/vpn/client.txt 2>/dev/null)
SCRIPT_EXP=$(cat /etc/vpn/exp.txt 2>/dev/null)

# Setup Database Pertama Kali
sqlite3 "$DB_FILE" "CREATE TABLE IF NOT EXISTS users (username TEXT, protocol TEXT, exp_date TEXT, ip_limit INTEGER DEFAULT 0, password TEXT, quota INTEGER DEFAULT 0, status TEXT DEFAULT 'active');" 2>/dev/null

# Kalkulasi Sisa Hari Skrip
current_date=$(date +%s)
exp_date=$(date -d "$SCRIPT_EXP" +%s 2>/dev/null)
if [ -n "$exp_date" ]; then
    sisa_hari=$(( ($exp_date - $current_date) / 86400 ))
    if [ "$sisa_hari" -lt 0 ]; then sisa_hari=0; fi
else
    sisa_hari=360
fi

# Sistem Deteksi Service Dinamis
sx_val=$(systemctl is-active --quiet xray && echo "ON" || echo "OFF")
sw_val=$(systemctl is-active --quiet ws-stunnel || systemctl is-active --quiet ws-dropbear || systemctl is-active --quiet dropbear || systemctl is-active --quiet ssh && echo "ON" || echo "OFF")
sb_val=$(systemctl is-active --quiet nginx || systemctl is-active --quiet haproxy && echo "ON" || echo "OFF")

[ "$sx_val" == "ON" ] && sx_disp="${G}ON ${NC}" || sx_disp="${R}OFF${NC}"
[ "$sw_val" == "ON" ] && sw_disp="${G}ON ${NC}" || sw_disp="${R}OFF${NC}"
[ "$sb_val" == "ON" ] && sb_disp="${G}ON ${NC}" || sb_disp="${R}OFF${NC}"

if [ "$sx_val" == "ON" ] && [ "$sw_val" == "ON" ] && [ "$sb_val" == "ON" ]; then sa_disp="${G}GOOD${NC}"; else sa_disp="${R}ERR ${NC}"; fi

OS=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n 1 | cut -d= -f2 | tr -d '"')
RAM=$(free -m | awk '/Mem:/ {print $2"M"}')
SWAP=$(free -m | awk '/Swap:/ {print $2"M"}')
IP=$(curl -s4 ifconfig.me)
CITY=$(curl -s4 http://ip-api.com/line?fields=city || curl -s4 https://ipinfo.io/city || echo "Unknown")
ISP=$(curl -s4 http://ip-api.com/line?fields=isp || curl -s4 https://ipinfo.io/org | cut -d " " -f 2- || echo "Unknown")
UPTIME=$(uptime -p | sed 's/up //')
MONTH=$(date +%B)
DAY=$(date +%A)

# ==========================================
# TRAFFIC REAL-TIME ENGINE
# ==========================================
IFACE=$(ip -o -4 route show to default | awk '{print $5}' | head -n 1)
if [[ -n "$IFACE" ]]; then
    VSTAT=$(vnstat -i $IFACE --oneline 2>/dev/null)
    if [[ -n "$VSTAT" ]]; then
        DAY_RX=$(echo "$VSTAT" | cut -d';' -f4 | sed 's/ //g')
        DAY_TX=$(echo "$VSTAT" | cut -d';' -f5 | sed 's/ //g')
        DAY_TOT=$(echo "$VSTAT" | cut -d';' -f6 | sed 's/ //g')
        MON_RX=$(echo "$VSTAT" | cut -d';' -f9 | sed 's/ //g')
        MON_TX=$(echo "$VSTAT" | cut -d';' -f10 | sed 's/ //g')
        MON_TOT=$(echo "$VSTAT" | cut -d';' -f11 | sed 's/ //g')
    fi
    R1=$(cat /sys/class/net/$IFACE/statistics/rx_bytes 2>/dev/null || echo 0)
    sleep 0.1
    R2=$(cat /sys/class/net/$IFACE/statistics/rx_bytes 2>/dev/null || echo 0)
    BPS=$(( (R2 - R1) * 10 * 8 ))
    KBIT=$(awk "BEGIN {printf \"%.2f\", $BPS/1024}")
    TRAFFIC="${KBIT} kbit/s"
fi
DAY_RX=${DAY_RX:-"0MiB"}; DAY_TX=${DAY_TX:-"0MiB"}; DAY_TOT=${DAY_TOT:-"0MiB"}
MON_RX=${MON_RX:-"0MiB"}; MON_TX=${MON_TX:-"0MiB"}; MON_TOT=${MON_TOT:-"0MiB"}
TRAFFIC=${TRAFFIC:-"0.00 kbit/s"}

# ==========================================
# BACKEND PROCESS (AUTO CLEANUP & AUTO LOCK)
# ==========================================
auto_cleanup() {
    local current_time=$(date +"%Y-%m-%d %H:%M:%S")
    mapfile -t expired_ssh < <(sqlite3 "$DB_FILE" "SELECT username FROM users WHERE protocol='ssh' AND username LIKE 'trial-%' AND exp_date <= '$current_time';")
    for tu_name in "${expired_ssh[@]}"; do
        if [ -n "$tu_name" ]; then sqlite3 "$DB_FILE" "DELETE FROM users WHERE username='$tu_name'"; userdel -f "$tu_name" 2>/dev/null; fi
    done
    sqlite3 "$DB_FILE" "DELETE FROM users WHERE protocol='vmess' AND username LIKE 'trial-%' AND exp_date <= '$current_time';"
}

auto_lock_users() {
    local active_ssh_pids=$(netstat -anp 2>/dev/null | grep ESTABLISHED | grep -E 'sshd|dropbear' | awk '{print $7}' | cut -d'/' -f1)
    local active_ssh_users=""
    if [ -n "$active_ssh_pids" ]; then active_ssh_users=$(echo "$active_ssh_pids" | xargs -I {} ps -o user= -p {} 2>/dev/null | awk '{print $1}'); fi
    mapfile -t ssh_users < <(sqlite3 "$DB_FILE" "SELECT username, ip_limit FROM users WHERE protocol='ssh' AND status!='locked';")
    for user_data in "${ssh_users[@]}"; do
        local u=$(echo "$user_data" | cut -d'|' -f1)
        local lim=$(echo "$user_data" | cut -d'|' -f2)
        if [[ -n "$lim" && "$lim" -gt 0 ]]; then
            local ip_count=$(echo "$active_ssh_users" | grep -w "$u" | wc -l)
            if [[ "$ip_count" -gt "$lim" ]]; then
                usermod -L "$u" 2>/dev/null; pkill -u "$u" 2>/dev/null
                sqlite3 "$DB_FILE" "UPDATE users SET status='locked' WHERE username='$u' AND protocol='ssh';"
            fi
        fi
    done

    if [ -f /var/log/xray/access.log ]; then
        local xray_stats=$(xray api statsquery --server=127.0.0.1:10085 2>/dev/null)
        mapfile -t vmess_users < <(sqlite3 "$DB_FILE" "SELECT username, ip_limit, quota FROM users WHERE protocol='vmess' AND status!='locked';")
        for user_data in "${vmess_users[@]}"; do
            local u=$(echo "$user_data" | cut -d'|' -f1)
            local lim=$(echo "$user_data" | cut -d'|' -f2)
            local qta=$(echo "$user_data" | cut -d'|' -f3)
            
            if [[ -n "$lim" && "$lim" -gt 0 ]]; then
                local ip_count=$(grep "accepted" /var/log/xray/access.log 2>/dev/null | grep -w "email: $u" | awk '{print $3}' | cut -d':' -f1 | sort -u | wc -l)
                if [[ "$ip_count" -gt "$lim" ]]; then
                    sqlite3 "$DB_FILE" "UPDATE users SET status='locked' WHERE username='$u' AND protocol='vmess'"; continue
                fi
            fi

            if [[ -n "$qta" && "$qta" -gt 0 ]]; then
                local traffic_bytes=$(echo "$xray_stats" | grep -A 1 "user>>>${u}>>>traffic>>>downlink" | grep "value" | awk '{print $2}' | tr -d '"')
                if [[ -n "$traffic_bytes" && "$traffic_bytes" -gt 0 ]]; then
                    local traffic_gb=$(( traffic_bytes / 1073741824 ))
                    if [[ "$traffic_gb" -ge "$qta" ]]; then
                        sqlite3 "$DB_FILE" "UPDATE users SET status='locked' WHERE username='$u' AND protocol='vmess'"
                    fi
                fi
            fi
        done
    fi
}

print_line() {
    local label="$1"; local val_raw="$2"; local val_fmt="$3"; local pad_label="${4:-7}"
    local lbl_pad=$(printf "%-${pad_label}s" "$label")
    local raw_str=" ${lbl_pad} : ${val_raw}"
    local pad=$(( 47 - ${#raw_str} ))
    local spaces=""
    [ $pad -gt 0 ] && spaces=$(printf '%*s' "$pad" '')
    echo -e "${C}│${NC}${G} ${lbl_pad} : ${NC}${val_fmt}${spaces}${NC}${C}│${NC}"
}

# EKSEKUSI BACKGROUND (Agar menu loading cepat)
auto_cleanup >/dev/null 2>&1 &
auto_lock_users >/dev/null 2>&1 &

# TAMPILAN MENU
clear
echo -e "${C}┌───────────────────────────────────────────────┐${NC}"
echo -e "${C}│${BG_RED}${G}                 LBJ TUNNELING                 ${NC}${C}│${NC}"
echo -e "${C}└───────────────────────────────────────────────┘${NC}"
echo -e "${C}┌───────────────────────────────────────────────┐${NC}"
print_line "OS" "${OS:0:36}" "${G}${OS:0:36}"
print_line "RAM" "${RAM:0:36}" "${G}${RAM:0:36}"
print_line "SWAP" "${SWAP:0:36}" "${G}${SWAP:0:36}"
print_line "CITY" "${CITY:0:36}" "${G}${CITY:0:36}"
print_line "ISP" "${ISP:0:36}" "${G}${ISP:0:36}"
print_line "IP" "${IP:0:36}" "${PINK}${IP:0:36}"
print_line "DOMAIN" "${DOMAIN:0:36}" "${G}${DOMAIN:0:36}"
print_line "UPTIME" "${UPTIME:0:36}" "${G}${UPTIME:0:36}"
echo -e "${C}│${P}-----------------------------------------------${NC}${C}│${NC}"
print_line "MONTH" "${MON_TOT}  [${MONTH}]" "${G}${MON_TOT}  ${C}[${MONTH}]"
print_line "RX" "${MON_RX}" "${G}${MON_RX}"
print_line "TX" "${MON_TX}" "${G}${MON_TX}"
echo -e "${C}│${P}-----------------------------------------------${NC}${C}│${NC}"
print_line "DAY" "${DAY_TOT}  [${DAY}]" "${G}${DAY_TOT}  ${C}[${DAY}]"
print_line "RX" "${DAY_RX}" "${G}${DAY_RX}"
print_line "TX" "${DAY_TX}" "${G}${DAY_TX}"
print_line "TRAFFIC" "${TRAFFIC}" "${G}${TRAFFIC}"
echo -e "${C}└───────────────────────────────────────────────┘${NC}"
echo -e "${C}┌───────────────────────────────────────────────┐${NC}"
echo -e "${C}│${NC}${G} XRAY : ${sx_disp}${C}│${NC}${G} SSH-WS : ${sw_disp}${C}│${NC}${G} LOADBLC : ${sb_disp}${C}│${NC} ${sa_disp} ${C}│${NC}"
echo -e "${C}└───────────────────────────────────────────────┘${NC}"
echo -e "${C}┌───────────────────────────────────────────────┐${NC}"
print_line "Version" "LBJv1.0" "${O}LBJv1.0" 12
print_line "Order By" "Admin" "${O}Admin" 12
print_line "Client Name" "${CLIENT_NAME:0:31}" "${O}${CLIENT_NAME:0:31}" 12
print_line "Expiry In" "${sisa_hari} Days" "${O}${sisa_hari} Days" 12
echo -e "${C}└───────────────────────────────────────────────┘${NC}"
echo -e "${B}-------------------------------------------------${NC}"
echo -e "   ${C}1.)${NC} ${C}☞${NC} ${G}SSH               ${C}6.)${NC} ${C}☞${NC} ${G}FEATURES${NC}"
echo -e "${C}│${NC}  ${C}2.)${NC} ${C}☞${NC} ${G}VMESS             ${C}7.)${NC} ${C}☞${NC} ${G}SET REDUCE/TIME  ${C}│${NC}"
echo -e "   ${C}3.)${NC} ${C}☞${NC} ${G}VLESS             ${C}8.)${NC} ${C}☞${NC} ${G}SET BRAND NAME${NC}"
echo -e "${C}│${NC}  ${C}4.)${NC} ${C}☞${NC} ${G}TROJAN            ${C}9.)${NC} ${C}☞${NC} ${G}CHECK SERVICES   ${C}│${NC}"
echo -e "   ${C}5.)${NC} ${C}☞${NC} ${G}SETUP BOT         ${C}x.)${NC} ${C}☞${NC} ${G}EXIT${NC}"
echo -e "${B}-------------------------------------------------${NC}"
echo ""
echo -ne "${G}Select From Options [1-9 or x] : ${NC}"; read opt

case $opt in
    1) m-ssh ;;
    2) m-vmess ;;
    3) echo -e "\n ${O}VLESS Utility sedang dipersiapkan...${NC}"; sleep 1 ;;
    4) echo -e "\n ${O}TROJAN Utility sedang dipersiapkan...${NC}"; sleep 1 ;;
    5|6|7|8|9) echo -e "\n ${O}Modul utilitas sedang dikembangkan.${NC}"; sleep 1 ;;
    x|X) clear; exit 0 ;;
    *) echo -e "\n ${R}Please enter an correct number${NC}"; sleep 1 ;;
esac
EOF
chmod +x /usr/bin/menu
