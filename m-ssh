    echo -e "${B}===============================================${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

lock_ssh() {
    trap 'echo -e "\n"; return' INT
    while true; do
        mapfile -t ssh_users < <(sqlite3 "$DB_FILE" "SELECT username, exp_date, status FROM users WHERE protocol='ssh' AND (status IS NULL OR status != 'locked');")
        total_acc=${#ssh_users[@]}

        if [ "$total_acc" -eq 0 ]; then
            clear
            echo -e "${B}-----------------------------------------------${NC}"
            echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
            echo -e "${B}-----------------------------------------------${NC}"
            echo -e "\n${R}You don't have an active accounts${NC}\n"
            sleep 2; return
        fi

        clear
        echo -e "${B}-----------------------------------------------${NC}"
