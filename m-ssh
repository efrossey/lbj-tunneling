check_login_ssh() {
    trap 'echo -e "\n"; return' INT
    clear
    echo -e "${PINK}               SSH USER LOGIN                  ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    printf "${G}  %-14s %-7s %-7s %s${NC}\n" "USER" "USAGE" "TOTAL" "LOG"
    echo -e "${B}-----------------------------------------------${NC}"
    
    mapfile -t active_pids < <(netstat -anp 2>/dev/null | grep ESTABLISHED | grep -E 'sshd|dropbear' | awk '{print $7}' | cut -d'/' -f1 | sort | uniq)
    total_login=0
    for pid in "${active_pids[@]}"; do
        if [ -n "$pid" ]; then
            user=$(ps -o user= -p "$pid" 2>/dev/null | awk '{print $1}')
            if [[ -n "$user" && "$user" != "root" && "$user" != "sshd" && "$user" != "messagebus" ]]; then
                usage="0GB"
                ips=$(netstat -anp 2>/dev/null | grep " $pid/" | wc -l)
                log_id=$RANDOM
                printf "${G}  %-14s %-7s %-7s %s${NC}\n" "${user:0:14}" "$usage" "$ips IP" "$log_id"
                ((total_login++))
            fi
        fi
    done

    if [ "$total_login" -eq 0 ]; then echo -e "${G}           No Active Login${NC}"; fi
    echo -e "${B}-----------------------------------------------${NC}"
    if [ "$total_login" -le 1 ]; then echo -e "${G}       Total Account: $total_login user login${NC}"; else echo -e "${G}       Total Account: $total_login users login${NC}"; fi
    echo -e "${B}-----------------------------------------------${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

list_ssh() {
    trap 'echo -e "\n"; return' INT
    clear
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
    echo -e "${B}-----------------------------------------------${NC}\n"
    echo -e "${B}===============================================${NC}"
    printf "${O}  %-14s %-11s %-4s %-4s %s${NC}\n" "USERNAME" "EXP DATE" "QTA" "LMT" "STATUS"
    echo -e "${B}===============================================${NC}"

    mapfile -t ssh_users < <(sqlite3 "$DB_FILE" "SELECT username, exp_date, ip_limit, status, quota FROM users WHERE protocol='ssh';")
    total_acc=${#ssh_users[@]}

    if [ "$total_acc" -eq 0 ]; then echo -e "${G}              No User Found                    ${NC}"
    else
        i=1
        for user_data in "${ssh_users[@]}"; do
            username=$(echo "$user_data" | awk -F'|' '{print $1}')
            exp_date=$(echo "$user_data" | awk -F'|' '{print $2}')
            limit=$(echo "$user_data" | awk -F'|' '{print $3}')
            status_db=$(echo "$user_data" | awk -F'|' '{print $4}')
            quota=$(echo "$user_data" | awk -F'|' '{print $5}')
            
            if [[ "$exp_date" == *" "* ]]; then
                clean_date=$(echo "$exp_date" | cut -d' ' -f1); formatted_date=$(date -d "$clean_date" +"%d %b,%y" 2>/dev/null || echo "$exp_date")
            else formatted_date=$(date -d "$exp_date" +"%d %b,%y" 2>/dev/null || echo "$exp_date"); fi
            
            status_show=""
            if [ "$status_db" == "locked" ]; then status_show="LOCK"; fi
            
            l_str="${limit}"
            [ -z "$limit" ] || [ "$limit" == "0" ] && l_str="UL"
            q_str="${quota}GB"
            [ -z "$quota" ] || [ "$quota" == "0" ] && q_str="UL"
            
            printf "${G}%2d) %-14s %-11s %-4s %-4s %s${NC}\n" "$i" "${username:0:14}" "${formatted_date:0:11}" "$q_str" "$l_str" "$status_show"
            ((i++))
        done
    fi

    echo -e "${B}===============================================${NC}"
