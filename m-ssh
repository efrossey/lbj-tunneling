#!/bin/bash

G="\e[92m"; O="\e[93m"; C="\e[36m"; B="\e[36m"; P="\e[35m"; PINK="\e[95m"; BG_RED="\e[41m"; BG_BLUE="\e[44m"; R="\e[91m"; NC="\e[0m"
DB_FILE="/etc/vpn/database.db"
DOMAIN=$(cat /etc/vpn/domain.txt 2>/dev/null)

create_ssh() {
    trap 'echo -e "\n"; return' INT
    while true; do
        clear
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "\n${G}Just input a number for Limit IP\n\n0 for No Limit\n\n${R}Press CTRL+C for CANCEL${NC}\n"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -ne "${G}Username      : ${NC}"; read user
        if [[ -z "$user" ]]; then continue; fi
        
        if [[ ${#user} -lt 3 ]] || [[ ${#user} -gt 17 ]]; then
            echo -e "\n${R}Minimum 3 characters\nMaximum 17 characters\nTry again in 2 second${NC}\n"; sleep 2; continue
        elif [[ ! "$user" =~ ^[a-z0-9]+$ ]]; then
            echo -e "\n${R}Don't use special characters and uppercase!\nTry again in 2 seconds${NC}\n"; sleep 2; continue
        fi

        db_check=$(sqlite3 "$DB_FILE" "SELECT username FROM users WHERE username='$user' AND protocol='ssh';")
        if [[ -n "$db_check" ]]; then
            echo -e "\n${G}Username      : ${O}${user}${NC}\n${G}Status        : ${G}Already Exists\n\nTry again in 2 seconds${NC}\n"; sleep 2; continue
        else break; fi
    done
    
    while true; do echo -ne "${G}Password      : ${NC}"; read pass; if [ -n "$pass" ]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Quota (GB)    : ${NC}"; read quota; if [[ "$quota" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Limit (IP)    : ${NC}"; read iplimit; if [[ "$iplimit" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done
    while true; do echo -ne "${G}Expired (day) : ${NC}"; read days; if [[ "$days" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done

    exp=$(date -d "+$days days" +"%Y-%m-%d")
    useradd -e $exp -s /bin/false -M $user 2>/dev/null
    echo -e "$user:$pass" | chpasswd
    sqlite3 "$DB_FILE" "INSERT INTO users (username, protocol, exp_date, ip_limit, password, quota) VALUES ('$user', 'ssh', '$exp', '$iplimit', '$pass', '$quota');"

    clear
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
    echo -e "${B}-----------------------------------------------${NC}\n"
    echo -e "${PINK}                 SSH/Dropbear                  ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}HOST              : $DOMAIN${NC}"
    echo -e "${G}Username          : $user${NC}"
    echo -e "${G}Password          : $pass${NC}"
    echo -e "${G}Quota             : ${quota}GB${NC}"
    echo -e "${G}Limit IP          : $iplimit${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}TLS               : 443,8443\nNone TLS          : 80,8080\nAny               : 2082,2083,8880\nOpenSSH           : 444\nDropbear          : 90,109,143\nSlowDNS           : 53,5300\nUDP-Custom        : 1-65535\nOHP + SSH         : 9080\nSquid Proxy       : 3128\nBadVPN UDPGW      : 7100-7600\nOpenVPN TCP       : 80,1194\nOpenVPN SSL       : 443\nOpenVPN UDP       : 25000\nOpenVPN DNS       : 53\nOHP + OVPN        : 9088${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${PINK}                    OpenVPN                    ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}http://$DOMAIN:81/myvpn-config.zip${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${O}         Expired  :  $exp${NC}"
    echo -e "${B}-----------------------------------------------${NC}\n"
    echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

trial_ssh() {
    trap 'echo -e "\n"; return' INT
    clear
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "\n${G}Time Format :\n\n  h - H (Hours)\n  m - M (Minutes)\n\nExample : ${O}1h${NC} ${G}for 1 hours${NC}\n\n${R}Press CTRL+C for CANCEL${NC}"
    echo -e "${B}-----------------------------------------------${NC}\n"
    
    while true; do
        echo -ne "${G}Trial Time       : ${NC}"; read trial_time
        unit=$(echo $trial_time | grep -o -i '[a-z]')
        val=$(echo $trial_time | grep -o '[0-9]*')
        if [[ "${unit,,}" == "h" ]] && [ -n "$val" ]; then
            exp_display="$val Hour"; exp_db=$(date -d "+$val hour" +"%Y-%m-%d %H:%M:%S"); exp_sys=$(date -d "+1 day" +"%Y-%m-%d"); break
        elif [[ "${unit,,}" == "m" ]] && [ -n "$val" ]; then
            exp_display="$val Minute"; exp_db=$(date -d "+$val minute" +"%Y-%m-%d %H:%M:%S"); exp_sys=$(date -d "+1 day" +"%Y-%m-%d"); break
        else echo -en "\e[1A\e[K"; fi
    done

    user="trial-$(tr -dc 'a-z0-9' < /dev/urandom | head -c 8)"
    pass=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 8)
    useradd -e $exp_sys -s /bin/false -M $user 2>/dev/null
    echo -e "$user:$pass" | chpasswd
    sqlite3 "$DB_FILE" "INSERT INTO users (username, protocol, exp_date, ip_limit, password) VALUES ('$user', 'ssh', '$exp_db', '1', '$pass');"

    clear
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
    echo -e "${B}-----------------------------------------------${NC}\n"
    echo -e "${PINK}                 SSH/Dropbear                  ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}HOST              : $DOMAIN\nUsername          : $user\nPassword          : $pass${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}TLS               : 443,8443\nNone TLS          : 80,8080\nAny               : 2082,2083,8880\nOpenSSH           : 444\nDropbear          : 90,109,143\nSlowDNS           : 53,5300\nUDP-Custom        : 1-65535\nOHP + SSH         : 9080\nSquid Proxy       : 3128\nBadVPN UDPGW      : 7100-7600\nOpenVPN TCP       : 80,1194\nOpenVPN SSL       : 443\nOpenVPN UDP       : 25000\nOpenVPN DNS       : 53\nOHP + OVPN        : 9088${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${PINK}                    OpenVPN                    ${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${G}http://$DOMAIN:81/myvpn-config.zip${NC}"
    echo -e "${B}-----------------------------------------------${NC}"
    echo -e "${O}         Expired  :  $exp_display${NC}"
    echo -e "${B}-----------------------------------------------${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

delete_ssh() {
    trap 'echo -e "\n"; return' INT
    while true; do
        clear
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -e "             ${PINK}SSH-Dropbear-OpenVPN              ${NC}"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -e "${B}===============================================${NC}"
        printf "${O}  %-14s %-15s %s${NC}\n" "USERNAME" "EXP DATE" "STATUS"
        echo -e "${B}===============================================${NC}"

        mapfile -t ssh_users < <(sqlite3 "$DB_FILE" "SELECT username, exp_date, status FROM users WHERE protocol='ssh';")
        total_acc=${#ssh_users[@]}

        declare -A user_map; declare -A exp_map
        if [ "$total_acc" -eq 0 ]; then echo -e "${G}              No User Found                    ${NC}"
        else
            i=1
            for user_data in "${ssh_users[@]}"; do
                username=$(echo "$user_data" | awk -F'|' '{print $1}')
                exp_date=$(echo "$user_data" | awk -F'|' '{print $2}')
                status_db=$(echo "$user_data" | awk -F'|' '{print $3}')
                if [[ "$exp_date" == *" "* ]]; then
                    clean_date=$(echo "$exp_date" | cut -d' ' -f1); formatted_date=$(date -d "$clean_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date")
                else formatted_date=$(date -d "$exp_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date"); fi
                status_show="UNLOCKED"
                if [ "$status_db" == "locked" ]; then status_show="LOCKED"; fi
                printf "${G}%2d) %-14s %-15s %s${NC}\n" "$i" "${username:0:14}" "$formatted_date" "$status_show"
                user_map[$i]="$username"; exp_map[$username]="$exp_date"
                ((i++))
            done
        fi
        echo -e "${B}===============================================${NC}"
        if [ "$total_acc" -le 1 ]; then echo -e "${O} Total Account: $total_acc user${NC}"; else echo -e "${O} Total Account: $total_acc users${NC}"; fi
        echo -e "${B}===============================================${NC}\n"
        echo -e "${G}Press CTRL+C for CANCEL${NC}\n"
        
        if [ "$total_acc" -eq 0 ]; then echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy; return; fi
        if [ "$total_acc" -eq 1 ]; then prompt_range="[1]"; else prompt_range="[1-$total_acc]"; fi
        echo -ne "${G}Select client $prompt_range or [user]: ${NC}"; read client_opt

        target_user=""
        valid_user=0
        if [[ "$client_opt" =~ ^[0-9]+$ ]] && [ "$client_opt" -le "$total_acc" ] && [ "$client_opt" -gt 0 ]; then
            target_user="${user_map[$client_opt]}"; del_exp="${exp_map[$target_user]}"; valid_user=1
        else
            for i in "${!user_map[@]}"; do
                if [ "${user_map[$i]}" == "$client_opt" ]; then target_user="$client_opt"; del_exp="${exp_map[$target_user]}"; valid_user=1; break; fi
            done
        fi
        if [ "$valid_user" -eq 0 ]; then echo -e "\n${R}User Not Found\nTry again in 2 second${NC}\n"; sleep 2; continue; else break; fi
    done

    echo -e "\n${G}You Choose ${C}☞${NC} ${G}$target_user [delete]${NC}\n"
    echo -ne "${G}Correct (y) ? ${NC}"; read confirm

    if [[ "${confirm,,}" == "y" ]]; then
        userdel -f "$target_user" 2>/dev/null
        sqlite3 "$DB_FILE" "DELETE FROM users WHERE username='$target_user' AND protocol='ssh';"
        if [[ "$del_exp" == *" "* ]]; then
            clean_date=$(echo "$del_exp" | cut -d' ' -f1); del_exp_formatted=$(date -d "$clean_date" +"%Y-%m-%d" 2>/dev/null || echo "$del_exp")
        else del_exp_formatted=$(date -d "$del_exp" +"%Y-%m-%d" 2>/dev/null || echo "$del_exp"); fi

        clear
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -e "         ${C}Account Deleted Successfully          ${NC}"
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${G}Client Name : ${O}$target_user\n${G}Expired On  : ${O}$del_exp_formatted${NC}"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy
    else
        echo -e "\n${R}Canceled.\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
    fi
}

renew_ssh() {
    trap 'echo -e "\n"; return' INT
    while true; do
        clear
        echo -e "${B}-----------------------------------------------${NC}"
        echo -e "${BG_RED}${G}                 LBJ TUNNELING                 ${NC}"
        echo -e "${B}-----------------------------------------------${NC}\n"
        echo -e "             ${PINK}SSH-Dropbear-OpenVPN              ${NC}"
        echo -e "${B}===============================================${NC}\n"
        echo -e "${B}===============================================${NC}"
        printf "${O}  %-14s %-15s %s${NC}\n" "USERNAME" "EXP DATE" "STATUS"
        echo -e "${B}===============================================${NC}"

        mapfile -t ssh_users < <(sqlite3 "$DB_FILE" "SELECT username, exp_date, status FROM users WHERE protocol='ssh';")
        total_acc=${#ssh_users[@]}

        declare -A user_map
        declare -A exp_map
        if [ "$total_acc" -eq 0 ]; then echo -e "${G}              No User Found                    ${NC}"
        else
            i=1
            for user_data in "${ssh_users[@]}"; do
                username=$(echo "$user_data" | awk -F'|' '{print $1}')
                exp_date=$(echo "$user_data" | awk -F'|' '{print $2}')
                status_db=$(echo "$user_data" | awk -F'|' '{print $3}')
                
                exp_sec=$(date -d "$exp_date" +%s 2>/dev/null)
                today_sec=$(date +%s)
                if [[ -n "$exp_sec" && "$today_sec" -ge "$exp_sec" ]]; then continue; fi

                if [[ "$exp_date" == *" "* ]]; then
                    clean_date=$(echo "$exp_date" | cut -d' ' -f1); formatted_date=$(date -d "$clean_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date")
                else formatted_date=$(date -d "$exp_date" +"%d %b,%Y" 2>/dev/null || echo "$exp_date"); fi
                status_show="UNLOCKED"
                if [ "$status_db" == "locked" ]; then status_show="LOCKED"; fi
                printf "${G}%2d) %-14s %-15s %s${NC}\n" "$i" "${username:0:14}" "$formatted_date" "$status_show"
                user_map[$i]="$username"
                exp_map[$username]="$exp_date"
                ((i++))
            done
        fi
        echo -e "${B}===============================================${NC}"
        if [ "$total_acc" -le 1 ]; then echo -e "${O} Total Account: $total_acc user${NC}"; else echo -e "${O} Total Account: $total_acc users${NC}"; fi
        echo -e "${B}===============================================${NC}\n"
        echo -e "${G}Press CTRL+C for CANCEL${NC}\n"
        if [ "$total_acc" -eq 0 ]; then echo -e "${PINK}Press Enter for Back to Manage${NC}"; read dummy; return; fi

        if [ "$total_acc" -eq 1 ]; then prompt_range="[1]"; else prompt_range="[1-$total_acc]"; fi
        echo -ne "${G}Select client $prompt_range or [user]: ${NC}"; read client_opt

        target_user=""
        valid_user=0
        if [[ "$client_opt" =~ ^[0-9]+$ ]] && [ "$client_opt" -le "$total_acc" ] && [ "$client_opt" -gt 0 ]; then
            target_user="${user_map[$client_opt]}"; valid_user=1
        else
            for i in "${!user_map[@]}"; do
                if [ "${user_map[$i]}" == "$client_opt" ]; then target_user="$client_opt"; valid_user=1; break; fi
            done
        fi
        if [ "$valid_user" -eq 0 ]; then echo -e "\n${R}User Not Found\nTry again in 2 second${NC}\n"; sleep 2; continue; else break; fi
    done

    echo -e "\n${G}You Choose ${C}☞${NC} ${G}$target_user [renew]${NC}\n"
    while true; do echo -ne "${G}Day   Extend     :  ${NC}"; read ext_days; if [[ "$ext_days" =~ ^[0-9]+$ ]]; then break; else echo -en "\e[1A\e[K"; fi; done

    old_exp="${exp_map[$target_user]}"
    if [[ "$old_exp" == *" "* ]]; then old_exp=$(echo "$old_exp" | cut -d' ' -f1); fi

    old_exp_sec=$(date -d "$old_exp" +%s 2>/dev/null)
    today_sec=$(date +%s)
    if [[ -n "$old_exp_sec" && "$old_exp_sec" -gt "$today_sec" ]]; then
        new_exp=$(date -d "$old_exp + $ext_days days" +"%Y-%m-%d")
    else new_exp=$(date -d "+$ext_days days" +"%Y-%m-%d"); fi

    display_exp=$(date -d "$new_exp" +"%d %b, %Y")
    usermod -e "$new_exp" "$target_user" 2>/dev/null
    sqlite3 "$DB_FILE" "UPDATE users SET exp_date='$new_exp' WHERE username='$target_user' AND protocol='ssh';"

    echo -e "\n${B}===============================================${NC}\n"
    echo -e "${G}Username         :  $target_user\nDays Added until :  $ext_days Days\nExpires on       :  ${O}$display_exp${NC}"
    echo -e "\n${B}===============================================${NC}\n\n${PINK}Press Enter for Back to Manage${NC}"; read dummy
}

